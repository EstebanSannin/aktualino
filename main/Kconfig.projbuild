menu "Aktualino"

    menu "WiFi (fallback credentials)"
        comment "Primary source is main/wifi_credentials.h, generated by tools/sync-build.sh from secrets/wifi.env. These Kconfig values are a backup used only when that header is absent."

        config AKTUALINO_WIFI_SSID
            string "WiFi SSID (fallback)"
            default "aktualino-dev"
            help
                Fallback SSID, used only when main/wifi_credentials.h is not
                present. Real dev creds come from secrets/wifi.env via
                tools/sync-build.sh. Never commit real credentials here.

        config AKTUALINO_WIFI_PASS
            string "WiFi password (fallback)"
            default ""
            help
                Fallback WiFi password. See AKTUALINO_WIFI_SSID.
    endmenu

    config AKTUALINO_SNTP_SERVER
        string "SNTP server"
        default "pool.ntp.org"
        help
            NTP server used at boot for secure time (SPEC §9). Uptane expiry
            checks are meaningless without trustworthy time.

    config AKTUALINO_OTA_URL
        string "Phase-0 OTA image URL"
        default "https://192.168.1.100:8443/firmware.bin"
        help
            HTTPS URL of the firmware image served by the Phase-0 dumb update
            server (tools/dumb-update-server.py) on the build host — a dev
            convenience predating Torizon Cloud. Set this to your own server's
            LAN address. (No per-server CA is embedded; the server's TLS cert
            must chain to the compiled-in Mozilla CA bundle.)

endmenu
