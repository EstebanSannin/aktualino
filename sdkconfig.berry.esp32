# Feature-ON build overlay for the Berry script secondary, classic ESP32.
# Layer AFTER sdkconfig.defaults + sdkconfig.defaults.esp32:
#   idf.py -DSDKCONFIG_DEFAULTS="sdkconfig.defaults;sdkconfig.defaults.esp32;sdkconfig.berry.esp32"
CONFIG_AKTUALINO_SCRIPT_SECONDARY=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.scripts.csv"
